# =============================================================
# Solimouv' — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# JAMAIS committer .env.local dans Git
# =============================================================

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # Usage serveur uniquement — ne jamais exposer au client

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FESTIVAL_DATE=2026-07-11T10:00:00Z

# --- Intégrations ---
MAKE_WEBHOOK_URL=                   # URL du webhook Make pour les notifications

# --- Seed (optionnel) ---
ADMIN_SEED_EMAIL=admin@solimouv.app
